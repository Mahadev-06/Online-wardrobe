# ============================================================
# Online Wardrobe — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================

# ------ Google Gemini AI ------
# Get your key from: https://aistudio.google.com/app/apikey
# The key should start with "AIza"
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ------ Firebase (Client-side config — safe to expose) ------
# These are read-only client keys protected by Firebase Security Rules.
# Get from: https://console.firebase.google.com/ → Project Settings → General
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
